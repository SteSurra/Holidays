# Private travel material must never enter the public guide.
.env
.env.*
private/
photos/
bookings/
documents/
tickets/
*.pdf
*.doc
*.docx
*.heic
*.heif
*.jpg
*.jpeg
*.png
*.webp

# Local editor/preview config, not part of the guide.
.claude/

# Device-gate / local npm scratch (vanilla guide has no build step).
node_modules/
package.json
package-lock.json
playwright-report/
test-results/

# Local QA campaign output only — recreate under qa/ during review; never ship.
qa/

# Scratch extracts / downloaded CLIs for offline pack sizing (can be multi-GB).
tmp/

# Story pipeline scratch (batches/ are source of truth and stay tracked)
story-work/*BRIEF.md
story-work/*-catalog.json
story-work/STATUS.md
story-work/ledger.md
story-work/audits/
